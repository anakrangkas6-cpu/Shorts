<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
<androidx.media3.ui.PlayerView android:id="@+id/playerView" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="false" app:resize_mode="zoom" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:orientation="horizontal" android:padding="16dp">
<ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_search" android:tint="#FFFFFF" android:layout_marginEnd="20dp" />
<ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_more" android:tint="#FFFFFF" />
</LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center|end" android:orientation="vertical" android:gravity="center" android:paddingEnd="12dp">
<ImageView android:id="@+id/btnLike" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_heart" android:tint="#FFFFFF" />
<TextView android:id="@+id/tvLikes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="74 rb" android:textColor="#FFFFFF" android:textSize="13sp" android:layout_marginBottom="16dp" />
<ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_comment" android:tint="#FFFFFF" />
<TextView android:id="@+id/tvComments" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="298" android:textColor="#FFFFFF" android:textSize="13sp" android:layout_marginBottom="16dp" />
<ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_bookmark" android:tint="#FFFFFF" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Simpan" android:textColor="#FFFFFF" android:textSize="13sp" android:layout_marginBottom="16dp" />
<ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_share" android:tint="#FFFFFF" />
<TextView android:id="@+id/tvShares" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bagikan" android:textColor="#FFFFFF" android:textSize="13sp" android:layout_marginBottom="16dp" />
<ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_remix" android:tint="#FFFFFF" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="72 rb" android:textColor="#FFFFFF" android:textSize="13sp" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="70dp" android:paddingBottom="70dp">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
<ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_profile" android:tint="#FFFFFF" />
<TextView android:id="@+id/tvUsername" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@nurealam-h4z" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp" android:layout_marginStart="8dp" />
<TextView android:id="@+id/btnSubscribe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Subscribe" android:background="@drawable/bg_subscribe" android:textColor="#000000" android:textStyle="bold" android:textSize="13sp" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_marginStart="10dp" />
</LinearLayout>
<TextView android:id="@+id/tvDesc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="#shortsvideos" android:textColor="#FFFFFF" android:textSize="14sp" android:layout_marginBottom="10dp" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_music" android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="5dp" android:paddingBottom="5dp">
<ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_music" android:tint="#FFFFFF" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kamin - EMIN &amp; JONY" android:textColor="#FFFFFF" android:textSize="12sp" android:layout_marginStart="6dp" />
</LinearLayout>
</LinearLayout>
<ImageView android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="bottom|end" android:layout_marginEnd="12dp" android:layout_marginBottom="70dp" android:src="@drawable/ic_music_disc" />
</FrameLayout>
